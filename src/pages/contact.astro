---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { EMAIL, INSTAGRAM_HANDLE, INSTAGRAM_URL, JOIN_URL, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Contact | ${SITE_TITLE}`}
			description="Get in touch with the University of Manitoba Matcha Club."
		/>
	</head>
	<body>
		<Header />

		<div class="hero small">
			<h1>Contact Us</h1>
			<p>Questions, collaborations, or just want to talk matcha? Reach out.</p>
		</div>

		<section>
			<div class="container center">
				<p class="eyebrow">Get in touch</p>
				<h2>We'd Love to Hear From You</h2>
				<div class="contact-grid">
					<a class="contact-card" href={`mailto:${EMAIL}`}>
						<span class="icon" aria-hidden="true">✉️</span>
						<h4>Email</h4>
						<p>{EMAIL}</p>
					</a>
					<a class="contact-card" href={INSTAGRAM_URL} target="_blank" rel="noopener">
						<span class="icon" aria-hidden="true">📸</span>
						<h4>Instagram</h4>
						<p>{INSTAGRAM_HANDLE}</p>
					</a>
					<a class="contact-card" href={JOIN_URL} target="_blank" rel="noopener">
						<span class="icon" aria-hidden="true">🍵</span>
						<h4>Become a Member</h4>
						<p>Fill out our sign-up form</p>
					</a>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
	.contact-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 28px;
		margin-top: 40px;
	}
	.contact-card {
		background: var(--white);
		border-radius: 16px;
		padding: 36px 24px;
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
		text-decoration: none;
		transition: transform 0.25s;
	}
	.contact-card:hover { transform: translateY(-6px); }
	.icon { font-size: 36px; display: block; margin-bottom: 10px; }
	.contact-card h4 {
		font-size: 16px;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--matcha-dark);
		margin-bottom: 6px;
	}
	.contact-card p { color: var(--matcha); font-weight: 500; word-break: break-word; }
</style>
