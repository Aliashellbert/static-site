---
import { EMAIL, IMG, INSTAGRAM_HANDLE, INSTAGRAM_URL } from '../consts';
const year = new Date().getFullYear();
---

<footer>
	<div class="footer-grid">
		<img class="footer-logo" src={IMG.logo} alt="UMMC Logo" />
		<div class="connect">
			<h5>CONNECT WITH US</h5>
			<p>Email: <a href={`mailto:${EMAIL}`}>{EMAIL.toUpperCase()}</a></p>
			<p>Instagram: <a href={INSTAGRAM_URL} target="_blank" rel="noopener">{INSTAGRAM_HANDLE}</a></p>
		</div>
		<img class="footer-img" src={IMG.footer} alt="Matcha" />
	</div>
	<div class="footer-bottom">
		<span>© {year} by University of Manitoba Matcha Club</span>
		<ul>
			<li><a href="/">Home</a></li>
			<li><a href="/about">About Us</a></li>
			<li><a href="/blog">Blog</a></li>
			<li><a href="/contact">Contact</a></li>
		</ul>
	</div>
</footer>

<style>
	footer { background: var(--cream); padding: 60px 24px 30px; }
	.footer-grid {
		max-width: 1100px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 40px;
		align-items: center;
	}
	.footer-logo { width: 110px; height: 110px; border-radius: 50%; object-fit: cover; }
	.footer-img { width: 260px; border-radius: 12px; }
	.connect h5 { font-size: 16px; letter-spacing: 3px; color: var(--matcha-dark); margin-bottom: 12px; }
	.connect p { font-size: 14px; text-transform: uppercase; letter-spacing: 1px; }
	.connect a { color: var(--matcha); text-decoration: none; }
	.connect a:hover { text-decoration: underline; }
	.footer-bottom {
		max-width: 1100px;
		margin: 40px auto 0;
		padding-top: 20px;
		border-top: 1px solid rgba(63, 90, 44, 0.15);
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 14px;
		font-size: 13px;
		color: var(--muted);
	}
	.footer-bottom ul { list-style: none; display: flex; gap: 22px; }
	.footer-bottom a { text-decoration: none; }
	.footer-bottom a:hover { color: var(--matcha); }

	@media (max-width: 820px) {
		.footer-grid { grid-template-columns: 1fr; text-align: center; justify-items: center; }
		.footer-bottom { justify-content: center; text-align: center; }
	}
</style>
